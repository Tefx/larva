{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonaSpec",
  "description": "Larva 0.9 JSON persona input. Canonical output includes all fields, with defaults applied, text normalized, policy arrays sorted, and a computed digest. Larva checks filename binding and verifies any supplied digest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "description", "prompt", "model"],
  "properties": {
    "id": { "$ref": "#/$defs/personaId" },
    "description": { "$ref": "#/$defs/personaText" },
    "prompt": { "$ref": "#/$defs/personaText" },
    "model": { "$ref": "#/$defs/wellFormedString", "type": "string", "pattern": "^[^\\s/]+/[^\\s]+$" },
    "thinking": {
      "type": "string",
      "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
      "default": "medium"
    },
    "can_spawn": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/personaId" },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      ],
      "default": false
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": { "$ref": "#/$defs/toolPatterns" },
        "deny": { "$ref": "#/$defs/toolPatterns" }
      },
      "default": { "allow": [], "deny": [] }
    },
    "spec_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "wellFormedString": {
      "$comment": "Under Unicode-aware regex matching, a valid surrogate pair is one code point outside this range.",
      "type": "string",
      "not": { "type": "string", "pattern": "[\\uD800-\\uDFFF]" }
    },
    "personaText": { "$ref": "#/$defs/wellFormedString", "type": "string", "pattern": "\\S" },
    "personaId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "toolPatterns": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/wellFormedString", "type": "string", "pattern": "^[^\\s*]+\\*?$" }
    }
  }
}
