{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonaSpec",
  "description": "Larva 0.9 canonical JSON persona definition. Normalization and supplied digest verification are performed by Larva.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "description", "prompt", "model"],
  "properties": {
    "id": { "$ref": "#/$defs/personaId" },
    "description": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "prompt": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "model": { "type": "string", "minLength": 1, "pattern": "^[^\\s/]+/[^\\s]+$" },
    "thinking": {
      "type": "string",
      "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
      "default": "medium"
    },
    "can_spawn": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/personaId" },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      ],
      "default": false
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": { "$ref": "#/$defs/toolPatterns" },
        "deny": { "$ref": "#/$defs/toolPatterns" }
      },
      "default": { "allow": [], "deny": [] }
    },
    "spec_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "personaId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "toolPatterns": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[^\\s*]+\\*?$" }
    }
  }
}
