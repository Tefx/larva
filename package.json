{
  "name": "pi-larva",
  "version": "0.9.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "keywords": ["pi-package"],
  "bin": { "larva": "./dist/cli.mjs" },
  "pi": { "extensions": ["./dist/pi-extension.js"] },
  "files": ["dist/", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:dist": "node scripts/build.mjs --dist-only",
    "test": "node --test 'tests/unit/*.test.ts' 'tests/integration/*.test.ts' 'tests/e2e/*.test.ts'",
    "test:unit": "node --test 'tests/unit/*.test.ts'",
    "test:integration": "node --test 'tests/integration/*.test.ts'",
    "test:e2e": "node --test 'tests/e2e/*.test.ts'"
  },
  "peerDependencies": {
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.1",
    "@earendil-works/pi-tui": "1.6.1",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  }
}
